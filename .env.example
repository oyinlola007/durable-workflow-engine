# Copy to .env and adjust. .env is gitignored; this file is committed.

# Read by docker-compose.yml (to create the database) and by src/db.ts (to connect).
# Changing user/password/db later needs `docker compose down -v` to take effect.
POSTGRES_USER=dwe
POSTGRES_PASSWORD=dwe
POSTGRES_DB=dwe
POSTGRES_PORT=5433

# Only read by the app. Defaults to localhost.
POSTGRES_HOST=localhost
